# URL do App da Web do Apps Script (Implantar → Nova implantação → App da Web)
# Deixe vazio para abrir o app em MODO DEMONSTRAÇÃO (dados locais de exemplo).
VITE_API_URL=

# Token da família (está na aba Config da planilha, gerado por instalar()).
# Opcional: se vazio, o app pede na tela de entrada / vem no link de convite.
VITE_TOKEN_FAMILIA=

# Caminho base. Vercel: "/" (padrão). GitHub Pages: "/nome-do-repositorio/"
VITE_BASE=/
